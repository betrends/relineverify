# Database (Postgres — e.g. a free instance from neon.tech)
DATABASE_URL="postgresql://user:password@your-host.neon.tech/dbname?sslmode=require"

# Session signing secret — generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"

# Talktiyu reseller API
TALKTIYU_API_KEY="tk_live_your_api_key_here"
TALKTIYU_BASE_URL="https://www.talktiyu.com"

# Percentage markup applied on top of Talktiyu's base price when charging
# your users (e.g. 30 = charge users 30% more than what Talktiyu charges you)
MARKUP_PERCENT="30"

# Korapay (get from Korapay Dashboard -> Settings -> API Keys & Webhooks)
# Set the webhook URL there to: <APP_URL>/api/wallet/webhook
KORAPAY_SECRET_KEY="sk_test_your_secret_key_here"

# Public URL of this app (used for Korapay redirect + webhook)
APP_URL="http://localhost:3000"

# Google OAuth (get from Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI must be: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Resend (get from resend.com -> API Keys). Without this, password reset
# links are logged to the server console instead of emailed.
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="Reline <onboarding@resend.dev>"
